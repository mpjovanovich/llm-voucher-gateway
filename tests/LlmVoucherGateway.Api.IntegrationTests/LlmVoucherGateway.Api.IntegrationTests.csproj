<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The Milestone 1 captures are the fake client's script. Linked rather than copied,
       so there is one source of truth and a re-capture cannot leave the tests asserting
       against a stale response shape. -->
  <ItemGroup>
    <Content Include="..\..\api_documentation\chat-completions\non-streaming-response.json"
             Link="Captures\non-streaming-response.json"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\api_documentation\chat-completions\streaming-response.md"
             Link="Captures\streaming-response.md"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LlmVoucherGateway.Api\LlmVoucherGateway.Api.csproj" />
  </ItemGroup>

</Project>