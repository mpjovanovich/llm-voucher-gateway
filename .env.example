# Per-machine settings. Copy to .env and edit; .env is gitignored.
#
# Read by docker compose (interpolated into docker-compose.llm.yml and
# docker-compose.prod.yml) and by the Makefile, so curl helpers target the same
# model and port as the running server.
# Values are unquoted. A variable exported in the shell wins over an unset one here.

VLLM_IMAGE=vllm/vllm-openai:v0.29.0
VLLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct
VLLM_GPU_MEMORY_UTILIZATION=0.85
VLLM_GPU_COUNT=1

# Host-side published port, dev only; production publishes no vLLM port. The
# gateway in a container still reaches http://llm-server:8000 regardless of this value.
VLLM_PORT=8000

# 1 on a WSL2 box, 0 on a native Linux host. Production defaults to 0 when unset.
VLLM_WSL2_ENABLE_PIN_MEMORY=1

# ---- Production only (docker-compose.prod.yml) ----

# Required. Bearer token for /admin. docker compose refuses to start without it.
# Generate one with: openssl rand -base64 32
# ADMIN_KEY=

# Host directory mounted at /data in the gateway: database and file logs.
# Must be writable by UID 1654.
# GATEWAY_DATA_DIR=/srv/llm-gateway/data
