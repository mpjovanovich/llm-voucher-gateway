# Read by docker compose (interpolated into docker-compose.llm.yml and
# docker-compose.prod.yml) and by the Makefile, so the curl helpers target the
# same model as the running server. Values are unquoted.
#
# Applications are written to fail fast when variables are unset. The values
# below are what the small dev box runs; they are examples, not recommendations,
# and nothing in the code depends on them.

# Required. The llm model this server serves.
VLLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct

# Required. Fraction of VRAM vLLM may use. Whatever is left after the weights
# load becomes KV cache, which is what holds request context and responses.
VLLM_GPU_MEMORY_UTILIZATION=0.85

# Optional, defaults to 8000, dev only - not used in prod; production publishes
# no vLLM port.  Host side of the published port, for curling vLLM directly in
# dev Makefile scripts. The gateway in a prod container still reaches
# http://llm-server:8000 regardless of this value.
VLLM_PORT=8000

# Optional, defaults to 0. Set to 1 on a WSL2 box, where vLLM keeps pinned
# memory opt-in. A native Linux host leaves it alone.
VLLM_WSL2_ENABLE_PIN_MEMORY=0

# ---- Production only (docker-compose.prod.yml) ----

# Required. Bearer token for /admin. Compose refuses to start without it.
# Generate one with: openssl rand -base64 32
# ADMIN_KEY=

# Host directory mounted at /data in the gateway: database and file logs.
# Defaults to /srv/llm-gateway/data. Must be writable by UID 1654.
# GATEWAY_DATA_DIR=/srv/llm-gateway/data
