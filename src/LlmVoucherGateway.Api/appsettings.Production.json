{
  "Serilog": {
    // Console is repeated because configuration merges arrays by index: a Production
    // file that started with File would replace the console sink rather than add to
    // it, and `docker compose logs gateway` would go quiet. The trailing "-" in the
    // path is where the sink inserts the date. Only the name is repeated, so the
    // console output template from appsettings.json still applies.
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "/data/logs/gateway-.log",
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  }
}
