{
  // MinimumLevel.Override is a JSON object rather than an array, so configuration
  // merges it by key: this adds one category back without disturbing the others
  // or repeating them. The same cannot be done with WriteTo — see
  // appsettings.Production.json.
  "Serilog": {
    "MinimumLevel": {
      "Override": {
        // On in development, where seeing each call to vLLM is how a connection
        // problem gets diagnosed. Off in production, where it is five lines a
        // request instead of one.
        "System.Net.Http.HttpClient": "Information"
      }
    }
  },
  "Inference": {
    "BaseUrl": "http://localhost:8000"
  },
  "Admin": {
    "Keys": ["dev-admin-key"]
  },
  "Database": {
    "Path": ".data/vouchers.db"
  }
}
